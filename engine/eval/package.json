{
  "name": "@sofagent/eval",
  "version": "1.2.2",
  "description": "sofagent 质量评估引擎 — 量化指标 / 评分逻辑 / evals 接口",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc",
    "test": "vitest run",
    "check": "tsc --noEmit"
  },
  "bin": {
    "sofagent-eval": "dist/cli.js"
  },
  "keywords": [
    "sofagent",
    "eval",
    "quality",
    "scoring"
  ],
  "license": "MIT",
  "author": "KongFangXun",
  "dependencies": {
    "@sofagent/audit": "1.2.2",
    "@sofagent/core": "1.2.2",
    "js-yaml": "^5.2.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "data/",
    "!dist/**/*.js.map",
    "!dist/**/*.d.ts.map",
    "!dist/**/*.test.*"
  ]
}
