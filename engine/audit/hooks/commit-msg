#!/bin/bash
# sofagent commit-msg hook v1.5.2
# 安装：sofagent-audit --init 或 sofagent-audit --install-hook
# commit-msg hook 接收 $1 = commit message 文件路径
# 变更：空提交同样发起引擎调用（message 类规则 A5/A9/A19 照常执行）；
#             新增 fresh-eyes run 冻结窗口锁检查（run 进行中阻断 driver 源码提交）

# 0. 读取 commit message（commit-msg hook 独有优势）
#    - subject（第一行）：A3 越界检查依赖此参数
#    - 完整 message：A9 注入检查依赖此参数（body 里的注入 payload 不能漏检）
COMMIT_MSG_FILE="$1"
COMMIT_SUBJECT=""
COMMIT_FULL_MSG=""
if [ -f "$COMMIT_MSG_FILE" ]; then
  COMMIT_SUBJECT=$(head -1 "$COMMIT_MSG_FILE")
  COMMIT_FULL_MSG=$(cat "$COMMIT_MSG_FILE")
fi

# 空 diff（典型是 git commit --allow-empty）**不再整体 early return**：
#   - 不依赖 diff 的校验（dist 完整性、.gitignore 兜底）照常执行；
#   - 引擎调用照常发起——引擎空 diff 短路已升级为 message 类规则照常执行
#     （A5/A9/A19），空提交不再是无审计盲区（详见下方第 4 步）。

# 1. Node.js 检测
if ! command -v node &>/dev/null; then
  echo "❌ sofagent-audit: Node.js 未找到，审计未运行"
  echo "   请安装 Node.js >= 18: https://nodejs.org"
  exit 1
fi

# 2. sofagent-audit 检测（优先用仓库本地 engine/audit/dist/，避免全局旧版版本漂移）
# v1.4.8 F-15: 全局回退分支不再 `command -v`（PATH 解析可被前置假 binary 完全
# 绕过——执行面与校验面路径错位），改与 2.1 校验面同源的 require.resolve 绝对
# 路径：node_modules 解析链不受 PATH 摆布，校验哪个文件就执行哪个文件。
# 🔴 v1.4.8 修复：原先用**相对路径**判断 `[ -f "engine/audit/dist/index.js" ]`，而候选路径
# 相对的是**当前工作目录**——在仓库子目录或临时仓（如验收场景的 /tmp/TMP_REPO）里提交时，
# 该判断恒假 ⇒ 静默回退到 PATH/全局包 ⇒ **审计执行的其实不是本仓代码**（验收场景 11 长期
# 「失败」的真因：它一直在测 npm 上的旧版本，本仓的修复与回归都测不到）。
# 正解：用 `git rev-parse --show-toplevel` 定位**本仓库根**再拼绝对路径。
#
# 0. 显式注入（v1.4.8 补）：`SOFAGENT_AUDIT_ENTRY` 让**测试/CI 能指定要测的 CLI**——
#    否则"用本仓 dist 审计一个临时仓"这类场景永远只能命中全局包（被测对象错位）。
#    🔴 **必须 fail-loud**：指定了却不存在就报错退出，**不得静默回退**——静默回退会让调用方
#    误以为测的是指定实现（正是本 bug 的成因：回退不可见 ⇒ 假信号）。
if command -v git >/dev/null 2>&1; then
  _REPO_TOP=$(git rev-parse --show-toplevel 2>/dev/null || true)
fi
# F-28 辅助：dist 聚合哈希内联计算（算法与 tools/audit-dist-hash.mjs 逐字一致——
# walk 收集 dist/**/*.js → 按相对路径排序 → 每文件「rel\0sha256」→ \1 连接 → sha256）。
# 为什么内联：原实现经 DIST_HASH_SCRIPT 相对路径读**被审仓**的 tools/ 脚本——被审仓
# 可投毒该脚本使「哈希不匹配」永假（校验器本身是被审对象可控的）。内联后 hook 自带
# 算法，被审仓内任何文件都不参与校验面。stdout = 64 位 sha256；dist 不存在输出空。
_aggregate_dist_hash() { # $1 = dist 目录绝对路径
  node -e '
const {createHash}=require("crypto"),{readFileSync,readdirSync,statSync}=require("fs"),{join,relative,sep}=require("path");
const distRoot=process.argv[1];
let ok=false; try{ok=statSync(distRoot).isDirectory()}catch(x){}
if(!ok){process.exit(0)}
const out=[];
(function walk(d){for(const e of readdirSync(d,{withFileTypes:true})){const p=join(d,e.name); if(e.isDirectory())walk(p); else if(e.isFile()&&e.name.endsWith(".js"))out.push(p);}})(distRoot);
const files=out.map(f=>({rel:relative(distRoot,f).split(sep).join("/"),abs:f})).sort((a,b)=>a.rel<b.rel?-1:a.rel>b.rel?1:0);
if(files.length===0){process.exit(0)}
const inputs=files.map(f=>f.rel+"\u0000"+createHash("sha256").update(readFileSync(f.abs)).digest("hex"));
process.stdout.write(createHash("sha256").update(inputs.join("\u0001"),"utf8").digest("hex"));
' "$1" 2>/dev/null
}

# F-28 信任根修复辅助：全局安装态解析（原 else 分支整体提为函数——repo-local
# 指纹不匹配时也要能落到这条路，且不能复制两份）。
# 返回：解析成功置 AUDIT_CMD 并做全局基准校验（失败 exit 1）；解析失败 exit 1。
resolve_global_audit() {
  # v1.4.8 F-15 补（验收实测修正三处）：① 解析目标是**包名** `@sofagent/audit`——
  # bin 名 `sofagent-audit` 不是包名，用它 require.resolve 必然 MODULE_NOT_FOUND
  # （全局安装场景 hook 全面误拦 + 完整性校验被静默跳过）；② require.resolve 默认
  # 只走 cwd 向上的本地解析链，`npm install -g` 装的包需追加全局包根回退
  # （execPath 推导 lib/node_modules + `npm root -g` 兜底，两条均不走 PATH，
  # 不重开 command -v 劫持面）；③ 解析得的 main 是库入口 public-api.js，须从
  # 包根推导 CLI 入口 dist/index.js 再执行（hook 要完整 CLI 而非库 API）。
  # 🔴 v1.5.0 TASK-10: 只走显式全局根限定解析（execPath 推导 + npm root -g），
  # 被审仓库内 node_modules 不进入解析域（防投放冒牌包）。
  RESOLVED_ENTRY=$(node -e "try{const p=require('path');let e=null;const r=[p.resolve(p.dirname(process.execPath),'..','lib','node_modules')];try{r.push(require('child_process').execSync('npm root -g',{encoding:'utf8',stdio:['ignore','pipe','ignore']}).trim())}catch(x){};for(const q of r){try{e=require.resolve('@sofagent/audit',{paths:[q]});break}catch(x){}};if(e)process.stdout.write(p.join(p.dirname(p.dirname(e)),'dist','index.js'))}catch(x){}" 2>/dev/null)
  if [ -n "$RESOLVED_ENTRY" ] && [ -f "$RESOLVED_ENTRY" ]; then
    # v1.5.0 TASK-10: 全局分支聚合哈希校验（独立基准 audit-global-dist-hash.txt，
    # 由 bash tools/audit-baseline-sync.sh --global 生成，与本仓口径互不污染）。
    _RESOLVED_ROOT=$(dirname "$(dirname "$RESOLVED_ENTRY")")
    SOFAGENT_HOME="${SOFAGENT_HOME:-$HOME/.sofagent}"
    _GLOBAL_HASH_RECORD="$SOFAGENT_HOME/internal/audit-global-dist-hash.txt"
    # F-28：全局分支哈希同样内联（原 _GLOBAL_HASH_SCRIPT 经被审仓 git-root 相对路径
    # 取 tools/ 脚本——同病：校验器被审对象可控）。全局包根下直接就是 dist/。
    _GLOBAL_HASH=$(_aggregate_dist_hash "$_RESOLVED_ROOT/dist")
    if [ -n "$_GLOBAL_HASH" ]; then
      if [ ! -f "$_GLOBAL_HASH_RECORD" ]; then
        echo "🔴 [sofagent] 全局审计引擎基准缺失——本地全局包的完整性无从比对"
        echo "   生成基准: bash tools/audit-baseline-sync.sh --global"
        exit 1
      fi
      _GLOBAL_RECORDED=$(tr -d '[:space:]' < "$_GLOBAL_HASH_RECORD" 2>/dev/null)
      if [ "$_GLOBAL_HASH" != "$_GLOBAL_RECORDED" ]; then
        echo "🔴 [sofagent] 全局审计引擎哈希不匹配（可能被投毒）: $RESOLVED_ENTRY"
        echo "   当前聚合哈希 ${_GLOBAL_HASH:0:12}... ≠ 基准 ${_GLOBAL_RECORDED:0:12}..."
        echo "   恢复: npm install -g @sofagent/audit 后重跑 bash tools/audit-baseline-sync.sh --global"
        exit 1
      fi
    fi
    AUDIT_CMD=(node "$RESOLVED_ENTRY")
  else
    echo "❌ sofagent-audit 未安装，审计未运行"
    echo "   请运行: npm install -g @sofagent/audit"
    exit 1
  fi
}

if [ -n "${SOFAGENT_AUDIT_ENTRY:-}" ]; then
  if [ ! -f "$SOFAGENT_AUDIT_ENTRY" ]; then
    echo "❌ SOFAGENT_AUDIT_ENTRY 指向的入口不存在: $SOFAGENT_AUDIT_ENTRY"
    echo "   （显式注入 fail-loud：不静默回退，避免被测对象与预期不符）"
    exit 1
  fi
  AUDIT_CMD=(node "$SOFAGENT_AUDIT_ENTRY")
elif [ -n "${_REPO_TOP:-}" ] && [ -f "$_REPO_TOP/engine/audit/dist/index.js" ]; then
  # F-28 信任根修复：repo-local 分支此前零校验——被审仓库自带 engine/audit/dist
  # 即被执行（恶意仓一处放置 = 每次 commit 以受害者身份执行攻击者代码，红队
  # /tmp 隔离仓端到端实测全通）。现加本仓指纹校验（只读判定，禁执行被审仓代码）：
  # 顶层 package.json name = sofagent-monorepo 且 engine/audit/package.json
  # name = @sofagent/audit。不匹配 → 告警并走全局安装态（resolve_global_audit）。
  _REPO_IS_SOFA=0
  if [ -f "$_REPO_TOP/package.json" ] && [ -f "$_REPO_TOP/engine/audit/package.json" ]; then
    _TOP_NAME=$(node -e "try{process.stdout.write(require(process.argv[1]).name||'')}catch{}" "$_REPO_TOP/package.json" 2>/dev/null)
    _AUD_NAME=$(node -e "try{process.stdout.write(require(process.argv[1]).name||'')}catch{}" "$_REPO_TOP/engine/audit/package.json" 2>/dev/null)
    if [ "$_TOP_NAME" = "sofagent-monorepo" ] && [ "$_AUD_NAME" = "@sofagent/audit" ]; then
      _REPO_IS_SOFA=1
    fi
  fi
  if [ "$_REPO_IS_SOFA" -eq 1 ]; then
    AUDIT_CMD=(node "$_REPO_TOP/engine/audit/dist/index.js")
  else
    echo "⚠️ [sofagent] 仓库自带 engine/audit 非本仓发行物，已忽略（完整性校验走全局安装态）"
    resolve_global_audit
  fi
elif [ -f "engine/audit/dist/index.js" ]; then
  # 🔴 保留「相对 CWD」这一环是**契约要求**（v1.4.8 回归教训）：单测在测试仓里建"迷你 dist"，
  # 靠 `cwd: repoDir` 下的相对路径命中；且 CI 里 `git rev-parse --show-toplevel` 可能失败
  # （实测 CI 报 `Command failed: git rev-parse --git-dir` ⇒ `_REPO_TOP` 为空），
  # 此时必须能落到本分支，否则会一路退到全局包/静默退出（CI 5 例失败的真因）。
  AUDIT_CMD=(node "engine/audit/dist/index.js")
else
  resolve_global_audit
fi

# 2.1 P1-A2: dist 完整性校验——防止本地覆写 dist 致审计失效
#     比对 engine/audit/dist 的**多入口聚合哈希**与记录的基准哈希。
#     为什么用聚合而不是 dist/index.js 单文件：dist 有多个可执行入口
#     （index.js 与 cli-quick.js 都是 bin，agent-shield.js / cli/agent-shield.js
#     各自独立），而 index.js 的 import 图覆盖不到那三个（实测从 index.js 出发
#     可达 17 个模块，均不含它们）。后果是双向的：
#       - 误报：只改 cli-quick.ts 并重建后 index.js 逐字节不变 → 报「dist 未重建」；
#       - 漏防：攻击者只覆写 cli-quick.js，单文件哈希同样发现不了。
#     聚合全部 dist/**/*.js（排序后逐个取内容哈希再聚合）后两个方向都闭合。
#     基准哈希存储在 ~/.sofagent/internal/audit-dist-hash.txt。
#     计算必须由 dist 之外的代码完成：若交给 dist/index.js 算，dist 被篡改时
#     哈希同样可伪造，防线 self-defeating。故用 tools/ 下的独立脚本。
#     v1.4.0 P1-A3：基准缺失时 FAIL 而非跳过——此前 if [ -f ] 缺基准即静默放行，
#     首次部署窗口内可植入冒牌引擎（基准仅 --doctor 生成而首装不生成，空窗被利用）。
#     v1.4.8：本判断同样保留「相对 CWD」兜底（CI 下 git rev-parse 可能失败）。
_DIST_ROOT_FOR_HASH="${_REPO_TOP:-}"
[ -n "$_DIST_ROOT_FOR_HASH" ] && [ -f "$_DIST_ROOT_FOR_HASH/engine/audit/dist/index.js" ] || _DIST_ROOT_FOR_HASH="$(pwd)"
if [ -f "$_DIST_ROOT_FOR_HASH/engine/audit/dist/index.js" ]; then
  SOFAGENT_HOME="${SOFAGENT_HOME:-$HOME/.sofagent}"
  # 主锚：全部 dist/**/*.js 的聚合哈希（任一入口变化都可观测），本 hook 的拦截判定只看它
  HASH_RECORD="$SOFAGENT_HOME/internal/audit-dist-hash.txt"
  # 兼容锚：仅 index.js 的哈希。@sofagent/core 的 runDoctor 按「整文件 == 一个
  # index.js 哈希」读它，语义不能改（换成聚合会让它恒判不匹配），故本 hook 只在其
  # 缺失时补生成，不再用它做拦截判定。
  LEGACY_RECORD="$SOFAGENT_HOME/internal/audit-hash.txt"
  # F-28：哈希计算内联（原 DIST_HASH_SCRIPT 相对路径读被审仓 tools/——被审仓可
  # 投毒校验器本身）。对齐 _DIST_ROOT_FOR_HASH 定位（本仓或 CWD 兜底）。
  CURRENT_HASH=$(_aggregate_dist_hash "$_DIST_ROOT_FOR_HASH/engine/audit/dist")
  # 兼容锚缺失时顺手补上——runDoctor 依赖它，补不上也只影响体检、不阻断本次提交
  if [ ! -f "$LEGACY_RECORD" ]; then
    node -e "const c=require('crypto'),f=require('fs');process.stdout.write(c.createHash('sha256').update(f.readFileSync('engine/audit/dist/index.js')).digest('hex'))" > "$LEGACY_RECORD" 2>/dev/null && chmod 600 "$LEGACY_RECORD" 2>/dev/null || true
  fi
  if [ -z "$CURRENT_HASH" ]; then
    # 算不出来 ≠ 一致。静默放行会让「完整性校验」变成摆设，必须让人看见没跑。
    echo "⚠️ [sofagent] dist 聚合哈希计算失败（engine/audit/dist 为空或不可读）——本次完整性校验未执行"
  elif [ ! -f "$HASH_RECORD" ]; then
    # F-28：基准禁止自动落锚。原实现用「当前算出的哈希」自动写基准并放行——首提交
    # 即把（可能已被污染的）dist 固化为合法基线，且与 SECURITY.md「基线缺失显性报错，
    # 不再自动记录」的承诺直接冲突（该承诺原只覆盖 doctor 路径）。改为：告警 + 显式
    # 指引 + 放行本次（首装后未建基线是正常态，不阻断提交；信任锚由显式命令建立）。
    echo "⚠️ [sofagent] dist 基线缺失——本次完整性校验未执行。运行 sofagent-audit --doctor 或 bash tools/audit-baseline-sync.sh 显式建立信任锚"
  else
    RECORDED_HASH=$(cat "$HASH_RECORD" 2>/dev/null | tr -d '[:space:]')

    # 双信号判定：dist 哈希变化有两种成因，单看 dist 无法区分，
    # 只能一律拦截，结果是每次 rebuild 后全仓 commit 被阻塞。追加「源码指纹」
    # 作为第二个信号即可分离：
    #   src 变 + dist 变 → 改过源码并重建，属预期 → 放行
    #   src 变 + dist 不变 → dist 过期（审计实际在跑旧代码）→ 告警
    #   src 不变 + dist 变 → 无法用「改源码」解释 = 真劫持 → fail-closed 拦截
    # 指纹必须由 dist 之外的代码计算：若交给 dist/index.js 算，dist 被篡改时
    # 指纹同样可伪造，防线 self-defeating。故此处直接调用 tools/ 下独立脚本。
    SRC_CHANGED=0
    CURRENT_SRC_FP=""
    RECORDED_SRC_FP=""
    SRC_RECORD="$SOFAGENT_HOME/internal/audit-src-fingerprint.txt"
    FP_SCRIPT="tools/audit-src-fingerprint.mjs"
    if [ -f "$FP_SCRIPT" ] && [ -f "$SRC_RECORD" ]; then
      CURRENT_SRC_FP=$(node "$FP_SCRIPT" "$(pwd)" 2>/dev/null)
      RECORDED_SRC_FP=$(cat "$SRC_RECORD" 2>/dev/null | tr -d '[:space:]')
      if [ -n "$CURRENT_SRC_FP" ] && [ -n "$RECORDED_SRC_FP" ] && [ "$CURRENT_SRC_FP" != "$RECORDED_SRC_FP" ]; then
        SRC_CHANGED=1
      fi
    fi

    if [ "$SRC_CHANGED" -eq 1 ]; then
      if [ -n "$CURRENT_HASH" ] && [ -n "$RECORDED_HASH" ] && [ "$CURRENT_HASH" = "$RECORDED_HASH" ]; then
        echo "⚠️ [sofagent] 审计模块源码已变更，但 dist 未重建——当前审计跑的是旧代码"
        echo "   请执行: npm run build --workspace=engine/audit"
      else
        echo "ℹ️ [sofagent] 审计模块源码已变更（src 指纹 ${RECORDED_SRC_FP:0:12}... → ${CURRENT_SRC_FP:0:12}...），dist 随之变化属预期，本次提交放行"
        echo "   同步信任锚: bash tools/audit-baseline-sync.sh"
      fi
    elif [ -n "$CURRENT_HASH" ] && [ -n "$RECORDED_HASH" ] && [ "$CURRENT_HASH" != "$RECORDED_HASH" ]; then
      echo "🔴 [sofagent] 审计模块完整性校验失败（P1-A2 dist 聚合哈希不匹配）"
      echo "   engine/audit/dist 下某个 .js 可能被替换（影子审计器劫持风险）。"
      echo "   源码未变（src 指纹 ${CURRENT_SRC_FP:0:12}...）——dist 变化无法用「改了源码」解释。"
      echo "   记录哈希: ${RECORDED_HASH:0:12}...  当前哈希: ${CURRENT_HASH:0:12}..."
      echo "   定位到具体文件: bash tools/audit-baseline-sync.sh --check"
      echo "   恢复原始 dist: npm run build --workspace=engine/audit"
      echo "   确认 dist 可信后重建信任锚: bash tools/audit-baseline-sync.sh"
      echo "   （注意：sofagent-audit --doctor 只体检、不覆盖已存在的基线，不能用它刷新）"
      exit 1
    fi
  fi
fi

# 2.5 B22: .sofagent/ ignore 兜底——防御 --install-hook 后用户手工删 .gitignore、
#     或旧版本安装未写入的间隙。若 .gitignore 未含 .sofagent/，自动补写（幂等），
#     防止 .sofagent/.git-shadow/ 快照数据被本次 commit 卷入仓库。
#     并发安全：check-then-append 在并发 commit 下会重复追加——用 .git/ 内 mkdir
#     原子锁互斥（mkdir 同名目录只有一个进程成功）。拿不到锁说明另一 commit 正在
#     补写，本兜底幂等、跳过即可；锁内二次检查防 TOCTOU。陈旧锁风险接受：兜底
#     本身是安装期写入的兜底，跳过仅回到「未兜底」状态，post-commit H-01 对账兜底。
if [ -f ".gitignore" ] && ! grep -q '^\.sofagent/$' ".gitignore" 2>/dev/null && ! grep -q '^\.sofagent/' ".gitignore" 2>/dev/null; then
  if mkdir ".git/sofagent-gitignore.lock" 2>/dev/null; then
    (
      trap 'rmdir ".git/sofagent-gitignore.lock" 2>/dev/null' EXIT
      if ! grep -q '^\.sofagent/' ".gitignore" 2>/dev/null; then
        printf '\n# sofagent 审计数据（本地配置 + 知识库 + 审计历史）\n.sofagent/\n' >> ".gitignore"
        echo "ℹ️ [sofagent] 已自动补充 .gitignore（排除 .sofagent/）"
      fi
    )
  fi
elif [ ! -f ".gitignore" ]; then
  printf '# sofagent 审计数据（本地配置 + 知识库 + 审计历史）\n.sofagent/\n' > ".gitignore"
  echo "ℹ️ [sofagent] 已自动创建 .gitignore（排除 .sofagent/）"
fi
# 已暂存的 .sofagent/ 路径移出暂存区（.sofagent/ 永不入库；git reset 单路径只影响本目录，不动其他暂存）
# v1.4.2 H-01: fail-loud 化——此前 `|| true` 会在 index.lock 竞态下静默吞掉 reset 失败（退出码 128），
# 导致 `git add -f .sofagent/` 的文件原样进入提交。现改为：
#   ① 先判断暂存区是否真有 .sofagent/ 条目——无条目直接跳过 reset，零成本消除绝大多数竞态触发面；
#   ② 有条目但 reset 失败 → 拒绝本次 commit 让用户重试（宁可 false-retry 也不可静默入库）。
# ⚠️ 行为边界（/tmp 隔离仓实测，macOS git 2.50.1/Apple Git-155）：tree 在 commit-msg 运行前已由
#    index 生成，且 commit 成功后主进程会把内存 index 写回磁盘——故本 reset 对「正在进行的这次
#    commit」与「成功后的后续 commit」均不生效（写回覆盖）。「当次」防线由 post-commit 的 HEAD tree
#    对账告警承担（见 post-commit 末尾 H-01 段）。reset 的真实生效场景是 commit 被拦截/中止时
#    （commit 未完成不写回 index）：清理 staged 的 .sofagent/，防用户修复违规后重试 commit 时卷入。
if git diff --cached --name-only -- .sofagent/ 2>/dev/null | grep -q .; then
  if ! git reset -q -- .sofagent/ 2>/dev/null; then
    echo "❌ [sofagent] 无法将 .sofagent/ 移出暂存区（index 可能被占用）。请稍后重试 commit。" >&2
    exit 1
  fi
fi

# 2.6 冻结窗口锁：fresh-eyes run 进行中不得提交 driver 源码改动。
#     锁由 driver 启动时写入（runId + 源码指纹 + PID），run 正常结束/SIGTERM 时删除。
#     锁在且 PID 存活且本次提交命中 FORGE/src/fresh-eyes-driver.mjs → 阻断
#     （主进程内存步骤表派发旧步骤名而磁盘代码已变，worker 会「未知步骤」全灭——
#     提交时阻断比事后 fail-closed 更早止损；与引擎 exit 86 运行时门禁两层兜底）。
#     PID 已死 = 锁滞留（历史残留）→ WARN 放行，不误伤。
#     空提交不命中 driver 源码 → 天然放行（锁只管源码变更）。
RUN_LOCK="$HOME/.sofagent/internal/fresh-eyes-run.lock"
if [ -f "$RUN_LOCK" ]; then
  _lock_info=$(node -e "try{const l=JSON.parse(require('fs').readFileSync(process.argv[1],'utf8'));process.stdout.write((l.pid||'')+' '+(l.runId||''))}catch{}" "$RUN_LOCK" 2>/dev/null || true)
  LOCK_PID="${_lock_info%% *}"
  LOCK_RUN="${_lock_info#* }"
  if [ -n "$LOCK_PID" ] && kill -0 "$LOCK_PID" 2>/dev/null; then
    if git diff --cached --name-only HEAD 2>/dev/null | grep -q "FORGE/src/fresh-eyes-driver.mjs"; then
      echo "🔴 [sofagent] fresh-eyes run ${LOCK_RUN} 进行中（pid=${LOCK_PID}）——冻结窗口内不得修改 driver 源码"
      echo "   run 进行中收编 driver 改动会导致主进程与磁盘步骤表错位，worker 分片全灭。"
      echo "   处置：等 run 收口后提交，或先停 run（产物保留，--resume 可续跑）再改再重启。"
      exit 1
    fi
  else
    echo "⚠️ [sofagent] fresh-eyes run 锁滞留（PID ${LOCK_PID:-未知} 已退出）——放行本次提交；确认无 run 后可删除: $RUN_LOCK"
  fi
fi

# 3. 审计范围固定为「暂存区（staged）= 即将提交的变更」
#    无论是否首次提交都用 --cached：
#    - commit-msg 钩子运行时提交尚未生成，staged 即本次提交的真实内容；
#    - 若用 HEAD，git diff HEAD 会包含工作区未暂存的无关改动（如未提交的源码残文件），
#      导致 A3「不改越界」误报不属于本次提交的文件（ghost bug，v1.1.4 修复）。
AUDIT_DIFF_ARG="--cached"

# 4. 正常运行审计
# --task 传 subject（A3 越界检查用）
# --commit-msg 传完整 message（A9 注入检查用）——两个参数都传
# AUDIT_CMD 用 bash 数组——仓库路径含空格时（如 /Users/foo/my repo/）不炸
# 空提交（--allow-empty，NO_STAGED_FILES=1）同样发起引擎调用：引擎的空 diff
# 短路已升级为「message 类规则照常执行」（A5 空 message / A9 注入 / A19 质量
# 只消费 commit message、不依赖 diff 内容），空提交不再是无审计盲区。
AUDIT_STDERR="$(mktemp /tmp/sofagent-hook-stderr-XXXXXX)"
if [ -n "$COMMIT_SUBJECT" ]; then
  "${AUDIT_CMD[@]}" --diff "$AUDIT_DIFF_ARG" --silent --ci --task "$COMMIT_SUBJECT" --commit-msg "$COMMIT_FULL_MSG" 2>"$AUDIT_STDERR"
else
  "${AUDIT_CMD[@]}" --diff "$AUDIT_DIFF_ARG" --silent --ci 2>"$AUDIT_STDERR"
fi
EXIT_CODE=$?

# v1.4.8 阶段九加固 / v1.4.9 P1-15 降为**兜底**：退出码是主判据（新版 audit 崩溃 = 专属码 4），
# 故下面的 stderr 特征扫描**不再是必需项**——它只用来兜住**旧版引擎**：旧版（含用户已装的
# 全局包）没有「崩溃」专属码，node 未捕获异常仍是 exit 1，会与「1=警告」撞码 ⇒ fail-open。
# 两条判据**互为冗余**：任一命中即阻断。本项只降措辞与定性，**阻断语义与判定顺序均未动**。
ENGINE_CRASH=0
if grep -qE "^(Error|TypeError|ReferenceError|RangeError|SyntaxError|UnhandledPromiseRejection)|throw new Error|at Object\.<anonymous>|Node\.js v[0-9]+" "$AUDIT_STDERR" 2>/dev/null; then
  ENGINE_CRASH=1
fi
rm -f "$AUDIT_STDERR"

if [ $ENGINE_CRASH -eq 1 ]; then
  echo ""
  echo "❌ sofagent audit: 审计引擎异常（stderr 含崩溃特征）——审计未完成，commit 已阻止。"
  echo "   即使退出码为 0/1（旧版引擎无「崩溃=4」契约），崩溃也不得被当作「通过/警告」放行。"
  echo "   排查：SOFAGENT_HOME 越界 / Node 版本 / dist 完整性。"
  exit 1
fi

if [ $EXIT_CODE -eq 2 ]; then
  echo ""
  echo "❌ sofagent audit: 检测到违规，commit 已阻止。"
  echo "   请修复违规项后重新提交。"
  exit 1
fi

if [ $EXIT_CODE -eq 1 ]; then
  echo ""
  echo "⚠️  sofagent audit: 检测到警告，但允许 commit。"
elif [ $EXIT_CODE -ne 0 ]; then
  echo ""
  echo "❌ sofagent audit: 审计引擎异常退出（exit ${EXIT_CODE}）——审计未完成，commit 已阻止。"
  echo "   契约：0=全绿 / 1=警告（放行）/ 2=违规（阻断）/ 3=非 git 仓库 / 4=引擎崩溃；"
  echo "   上述五者之外的退出码 = 环境异常"
  echo "   （SOFAGENT_HOME 越界 fail-loud / Node 缺失 / dist 异常等）。静默放行 = 0 处违规但根本"
  echo "   没在看 = fail-open，故此处 fail-loud。"
  exit 1
fi

exit 0
