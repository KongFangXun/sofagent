{
  "id": "sofagent-evolve",
  "name": "sofagent 进化",
  "description": "给 OpenClaw 加上经验沉淀——sofagent_evolve 工具把踩坑写成 think.md 反思条目（可选每轮提醒，默认关）",
  "version": "1.5.3",
  "seam": "before_prompt_build",
  "seamSemantics": "模型调用前注入 think.md 反思区（进化闭环上下文）",
  "icon": "https://raw.githubusercontent.com/KongFangXun/sofagent/main/docs/assets/sofagent.png",
  "uiHints": {
    "brandColor": {
      "label": "品牌色",
      "placeholder": "#16B8F3"
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "brandColor": {
        "type": "string",
        "default": "#16B8F3"
      },
      "reflectHint": {
        "type": "boolean",
        "default": false,
        "description": "每轮注入一行收尾提示（默认关：think.md 已由 sofagent-inject 的 L2 层注入，重复注入是噪声）"
      }
    }
  }
}
