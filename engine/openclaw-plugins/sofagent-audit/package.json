{
  "name": "sofagent-audit",
  "version": "1.4.3",
  "description": "变更机器审阅——24 规则 + git diff 硬证据 + 危险工具拦截（before_tool_execute），品牌色 #16B8F3",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.7.1-2"
    },
    "build": {
      "openclawVersion": "2026.7.1-2"
    }
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "sofagent",
    "openclaw",
    "plugin",
    "audit"
  ],
  "license": "MIT",
  "author": "KongFangXun",
  "repository": {
    "type": "git",
    "url": "https://github.com/KongFangXun/sofagent"
  },
  "bugs": {
    "url": "https://github.com/KongFangXun/sofagent/issues"
  },
  "homepage": "https://github.com/KongFangXun/sofagent#readme",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist/",
    "openclaw.plugin.json",
    "README.md",
    "!dist/**/*.js.map",
    "!dist/**/*.d.ts.map"
  ]
}
