{
  "name": "sofagent-inject",
  "version": "1.5.3",
  "private": true,
  "description": "给 OpenClaw 加上约束注入——每次构建提示词前带上企业铁律 / 反思 / 用户规则 / 知识库（四层加载链）",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.7.1-2"
    },
    "build": {
      "openclawVersion": "2026.7.1-2"
    }
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "test": "vitest run src/index.test.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "sofagent",
    "openclaw",
    "plugin",
    "inject",
    "constraint",
    "load-chain"
  ],
  "license": "MIT",
  "author": "KongFangXun",
  "repository": {
    "type": "git",
    "url": "https://github.com/KongFangXun/sofagent"
  },
  "bugs": {
    "url": "https://github.com/KongFangXun/sofagent/issues"
  },
  "homepage": "https://github.com/KongFangXun/sofagent#readme",
  "devDependencies": {
    "@types/node": "^24.13.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist/",
    "openclaw.plugin.json",
    "README.md",
    "!dist/**/*.js.map",
    "!dist/**/*.d.ts.map"
  ]
}
