{
  "name": "@sofagent/rules",
  "version": "1.2.6",
  "description": "sofagent 规则引擎纯函数包——从 audit 抽出，零 fs/git 依赖，供编排引擎 tool call 事前拦截",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "npm run clean && tsc",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "keywords": [
    "rules-engine",
    "agent-safety",
    "tool-interceptor"
  ],
  "author": "孔放勋",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  },
  "files": [
    "dist/",
    "!dist/**/*.js.map",
    "!dist/**/*.d.ts.map",
    "!dist/**/*.test.*",
    "README.md"
  ],
  "dependencies": {
    "@sofagent/core": "^1.2.4"
  }
}
