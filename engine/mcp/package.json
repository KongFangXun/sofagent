{
  "name": "@sofagent/mcp",
  "version": "1.3.9",
  "description": "sofagent MCP Server — 暴露审计能力给 MCP Client（JSON-RPC 2.0 over stdio）",
  "main": "dist/mcp-server.js",
  "types": "dist/mcp-server.d.ts",
  "files": [
    "dist/",
    "!dist/**/*.js.map",
    "!dist/**/*.d.ts.map",
    "!dist/**/*.test.*",
    "README.md"
  ],
  "bin": {
    "sofagent-mcp": "dist/mcp-server.js"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "postbuild": "node -e \"const fs=require('fs');for(const b of ['dist/mcp-server.js']){try{fs.chmodSync(require('path').join(__dirname,b),0o755)}catch(e){}}\"",
    "prepublishOnly": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && npm run build && find dist -name '*.js.map' -delete && find dist -name '*.d.ts.map' -delete",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "sofagent",
    "mcp",
    "model-context-protocol",
    "audit"
  ],
  "license": "MIT",
  "author": "KongFangXun",
  "repository": {
    "type": "git",
    "url": "https://github.com/KongFangXun/sofagent"
  },
  "bugs": {
    "url": "https://github.com/KongFangXun/sofagent/issues"
  },
  "homepage": "https://github.com/KongFangXun/sofagent#readme",
  "dependencies": {
    "@sofagent/audit": "1.3.9",
    "@sofagent/ab-test": "1.3.9",
    "@sofagent/core": "1.3.9",
    "@sofagent/orchestrator": "1.3.9",
    "@sofagent/think": "1.3.9",
    "@sofagent/ontology": "1.3.9",
    "@sofagent/eval": "1.3.9",
    "@sofagent/skillopt": "1.3.9",
    "@sofagent/rules": "1.3.9"
  },
  "optionalDependencies": {
    "@sofagent/daemon": "1.3.9"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/mcp-server.d.ts",
      "require": "./dist/mcp-server.js",
      "default": "./dist/mcp-server.js"
    },
    "./package.json": "./package.json"
  }
}
