{
  "name": "@sofagent/load-chain",
  "version": "1.3.1",
  "description": "sofagent 加载链 Hook——agent:bootstrap 时注入 fde.md + think.md（OpenClaw 2026.6.x 声明式内部 hook）",
  "main": "dist/handler.js",
  "types": "dist/handler.d.ts",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "prepublishOnly": "npm run build && find dist -name '*.js.map' -delete && find dist -name '*.d.ts.map' -delete"
  },
  "keywords": [
    "sofagent",
    "hook",
    "load-chain",
    "openclaw",
    "bootstrap"
  ],
  "license": "MIT",
  "author": "KongFangXun",
  "repository": {
    "type": "git",
    "url": "https://github.com/KongFangXun/sofagent"
  },
  "bugs": {
    "url": "https://github.com/KongFangXun/sofagent/issues"
  },
  "homepage": "https://github.com/KongFangXun/sofagent#readme",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist/",
    "HOOK.md",
    "!dist/**/*.js.map",
    "!dist/**/*.d.ts.map"
  ]
}
