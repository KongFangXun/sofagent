{
  "name": "@sofagent/orchestrator",
  "version": "1.2.0",
  "description": "sofagent 编排引擎 — 多 Agent 协作 / 工作流调度 / prompt 模板",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "sofagent-orchestrator": "dist/cli.js",
    "sofagent-orchestrator-compare": "dist/orchestrator-compare.js"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc && [ -f dist/cli.js ] && chmod +x dist/cli.js || true; [ -f dist/orchestrator-compare.js ] && chmod +x dist/orchestrator-compare.js || true",
    "test": "vitest run",
    "check": "tsc --noEmit"
  },
  "keywords": [
    "sofagent",
    "orchestrator",
    "workflow",
    "agent"
  ],
  "license": "MIT",
  "author": "KongFangXun",
  "dependencies": {
    "@langchain/core": "^1.2.3",
    "@langchain/langgraph": "^1.4.7",
    "@langchain/openai": "^1.5.5",
    "@sofagent/audit": "1.2.0",
    "@sofagent/core": "1.2.0",
    "@sofagent/harness": "1.2.0",
    "@sofagent/rules": "1.2.0",
    "js-yaml": "^5.2.0",
    "zod": "^4.4.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "!dist/**/*.js.map",
    "!dist/**/*.d.ts.map",
    "!dist/**/*.test.*"
  ]
}
