{
  "name": "@sofagent/orchestrator",
  "version": "1.4.2",
  "engines": {
    "node": ">=18"
  },
  "description": "sofagent 编排引擎 — 多 Agent 协作 / 工作流调度 / prompt 模板",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "sofagent-orchestrator": "dist/cli.js",
    "sofagent-orchestrator-compare": "dist/orchestrator-compare.js"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "postbuild": "node -e \"const fs=require('fs');for(const b of ['dist/cli.js','dist/orchestrator-compare.js']){try{fs.chmodSync(require('path').join(__dirname,b),0o755)}catch(e){}}\"",
    "test": "vitest run",
    "check": "tsc --noEmit"
  },
  "keywords": [
    "sofagent",
    "orchestrator",
    "workflow",
    "agent"
  ],
  "license": "MIT",
  "author": "KongFangXun",
  "//automerge": "v1.3.5 交付 4b：已切换 @automerge/automerge ^3.4.1（Rust WASM 稳定核心，旧 automerge 1.0.1-preview.7 包名废弃）。迁移面：team-state.ts / team-manager.ts / protocol.ts + core/federation.ts（API 对照见 v1.3.5 dev-prompt 交付 4b 段）。回归保险：orchestrator team-state.regression.test.ts（11 用例）+ 联邦同步测试。",
  "dependencies": {
    "@automerge/automerge": "^3.4.1",
    "@deepseek-ai/dsh": "0.1.2-alpha.1",
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.12",
    "@langchain/openai": "^1.5.10",
    "@sofagent/audit": "1.4.2",
    "@sofagent/core": "1.4.2",
    "@sofagent/harness": "1.4.2",
    "@sofagent/rules": "1.4.2",
    "@sofagent/skillopt": "1.4.2",
    "js-yaml": "^5.3.0",
    "zod": "^4.4.3",
    "@deepseek-ai/dsh-app-boot": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-llm": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-session": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-agent": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-home-paths": "0.1.2-alpha.1"
  },
  "devDependencies": {
    "@sofagent/daemon": "1.4.2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "!dist/**/*.js.map",
    "!dist/**/*.d.ts.map",
    "!dist/**/*.test.*"
  ]
}