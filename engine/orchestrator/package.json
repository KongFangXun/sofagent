{
  "name": "@sofagent/orchestrator",
  "version": "1.5.3",
  "engines": {
    "node": ">=18"
  },
  "description": "sofagent 编排模块 — 多 Agent 协作 / 工作流调度 / prompt 模板",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "sofagent-orchestrator": "dist/cli.js",
    "sofagent-orchestrator-compare": "dist/orchestrator-compare.js"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "prepublishOnly": "npm run build && find dist -name '*.js.map' -delete && find dist -name '*.d.ts.map' -delete",
    "postbuild": "node -e \"const fs=require('fs');for(const b of ['dist/cli.js','dist/orchestrator-compare.js']){try{fs.chmodSync(require('path').join(__dirname,b),0o755)}catch(e){}}\"",
    "test": "vitest run",
    "check": "tsc --noEmit"
  },
  "keywords": [
    "sofagent",
    "orchestrator",
    "workflow",
    "agent"
  ],
  "license": "MIT",
  "author": "KongFangXun",
  "//automerge": "v1.3.5 交付 4b：已切换 @automerge/automerge ^3.4.1（Rust WASM 稳定核心，旧 automerge 1.0.1-preview.7 包名废弃）。迁移面：team-state.ts / team-manager.ts / protocol.ts + core/federation.ts（API 对照见 v1.3.5 dev-prompt 交付 4b 段）。回归保险：orchestrator team-state.regression.test.ts（11 用例）+ 联邦同步测试。",
  "//dsh-web-app": "解析锚点（非直接调用）：@deepseek-ai/dsh-web-app 是 @deepseek-ai/dsh 的传递依赖，其 0.1.5-rc.3 把 documentpreview 需求从 ^0.1.5-rc.2 抬到 ^0.1.5-rc.3，而 @deepseek-ai/dsh-client-ui-sidebar-documentpreview 从未发布 rc.3（最高 0.1.5-rc.2）——caret 在无 lock 的全新安装里会解析到 rc.3 → ETARGET 装不上。精确钉 rc.2（其自身需求 ^0.1.5-rc.2 可解析）把这条传递边的 caret 漂移钉死。实证：仅装 @deepseek-ai/dsh@0.1.5-rc.2 → ETARGET；补本钉后 dry-run 通过。上游补齐 documentpreview rc.3 后可移除。",
  "dependencies": {
    "@automerge/automerge": "^3.5.0",
    "@deepseek-ai/dsh": "0.1.5-rc.2",
    "@deepseek-ai/dsh-agent": "0.1.5-rc.2",
    "@deepseek-ai/dsh-app-boot": "0.1.5-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "0.1.5-rc.2",
    "@deepseek-ai/dsh-web-app": "0.1.5-rc.2",
    "@langchain/core": "^1.2.11",
    "@langchain/langgraph": "^1.4.15",
    "@langchain/openai": "^1.5.13",
    "@sofagent/audit": "1.5.3",
    "@sofagent/core": "1.5.3",
    "@sofagent/inject": "1.5.3",
    "@sofagent/rules": "1.5.3",
    "@sofagent/evolve": "1.5.3",
    "js-yaml": "^5.4.2",
    "zod": "^4.6.5"
  },
  "//optionalDependencies": "v1.4.5 T6 (R4)：benchmark/case-evaluator.ts:188 惰性 await import('@sofagent/eval')（裁剪安装时回退协议完成度），此前未声明——对齐 root package.json F-18 optionalDependencies 先例（惰性加载的跨 workspace 依赖声明为 optional，裁剪安装不断言）。",
  "optionalDependencies": {
    "@sofagent/eval": "1.5.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./loop": {
      "types": "./dist/loop/index.d.ts",
      "require": "./dist/loop/index.js",
      "default": "./dist/loop/index.js"
    },
    "./model-registry": {
      "types": "./dist/model-registry.d.ts",
      "require": "./dist/model-registry.js",
      "default": "./dist/model-registry.js"
    },
    "./team-state": {
      "types": "./dist/team/team-state.d.ts",
      "require": "./dist/team/team-state.js",
      "default": "./dist/team/team-state.js"
    },
    "./workflow": {
      "types": "./dist/workflow/index.d.ts",
      "require": "./dist/workflow/index.js",
      "default": "./dist/workflow/index.js"
    },
    "./fde-compose": {
      "types": "./dist/fde-compose/index.d.ts",
      "require": "./dist/fde-compose/index.js",
      "default": "./dist/fde-compose/index.js"
    },
    "./worklog": {
      "types": "./dist/worklog/aggregator.d.ts",
      "require": "./dist/worklog/aggregator.js",
      "default": "./dist/worklog/aggregator.js"
    },
    "./benchmark": {
      "types": "./dist/benchmark/benchmark-designer.d.ts",
      "require": "./dist/benchmark/benchmark-designer.js",
      "default": "./dist/benchmark/benchmark-designer.js"
    },
    "./benchmark-eval": {
      "types": "./dist/benchmark-eval.d.ts",
      "require": "./dist/benchmark-eval.js",
      "default": "./dist/benchmark-eval.js"
    },
    "./fde-quantify-core": {
      "types": "./dist/fde/quantify-core.d.ts",
      "require": "./dist/fde/quantify-core.js",
      "default": "./dist/fde/quantify-core.js"
    },
    "./weights-manifest": {
      "types": "./dist/weights-manifest.d.ts",
      "require": "./dist/weights-manifest.js",
      "default": "./dist/weights-manifest.js"
    },
    "./sandbox-network-gateway": {
      "types": "./dist/sandbox/network-gateway.d.ts",
      "require": "./dist/sandbox/network-gateway.js",
      "default": "./dist/sandbox/network-gateway.js"
    }
  },
  "files": [
    "dist/",
    "!dist/**/*.js.map",
    "!dist/**/*.d.ts.map",
    "!dist/**/*.test.*"
  ]
}
