{
  "name": "@sofagent/core",
  "version": "1.3.0",
  "description": "sofagent 核心运行时 — doctor / 配置解析 / 通用类型（不含审计逻辑）",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "sofagent-core": "dist/cli.js"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc",
    "test": "vitest run",
    "check": "tsc --noEmit"
  },
  "keywords": [
    "sofagent",
    "core",
    "runtime",
    "doctor"
  ],
  "license": "MIT",
  "author": "KongFangXun",
  "repository": {
    "type": "git",
    "url": "https://github.com/KongFangXun/sofagent"
  },
  "bugs": {
    "url": "https://github.com/KongFangXun/sofagent/issues"
  },
  "homepage": "https://github.com/KongFangXun/sofagent#readme",
  "//": "automerge 精确锁版 1.0.1-preview.7：稳定版（2.x）API 不兼容本项目 CRDT 同步用法；preview 版是唯一可用版本，升级需验证 multi-device-sync 测试全绿后再放开",
  "dependencies": {
    "automerge": "1.0.1-preview.7",
    "js-yaml": "^5.2.0"
  },
  "files": [
    "dist/",
    "!dist/**/*.js.map",
    "!dist/**/*.d.ts.map",
    "!dist/**/*.test.*"
  ]
}
