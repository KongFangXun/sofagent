{
  "name": "@sofagent/core",
  "version": "1.5.6",
  "engines": {
    "node": ">=18"
  },
  "description": "sofagent 核心运行时 — doctor / 配置解析 / 数据路径 SSOT / 哈希链原语与审计基础件 / 通用类型",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./domain/shared": {
      "types": "./dist/domain/shared.d.ts",
      "require": "./dist/domain/shared.js",
      "default": "./dist/domain/shared.js"
    },
    "./domain/config": {
      "types": "./dist/domain/config.d.ts",
      "require": "./dist/domain/config.js",
      "default": "./dist/domain/config.js"
    },
    "./domain/security": {
      "types": "./dist/domain/security.d.ts",
      "require": "./dist/domain/security.js",
      "default": "./dist/domain/security.js"
    },
    "./domain/crypto": {
      "types": "./dist/domain/crypto.d.ts",
      "require": "./dist/domain/crypto.js",
      "default": "./dist/domain/crypto.js"
    },
    "./domain/runtime": {
      "types": "./dist/domain/runtime.d.ts",
      "require": "./dist/domain/runtime.js",
      "default": "./dist/domain/runtime.js"
    },
    "./domain/memory": {
      "types": "./dist/domain/memory.d.ts",
      "require": "./dist/domain/memory.js",
      "default": "./dist/domain/memory.js"
    },
    "./domain/audit": {
      "types": "./dist/domain/audit.d.ts",
      "require": "./dist/domain/audit.js",
      "default": "./dist/domain/audit.js"
    },
    "./domain/export": {
      "types": "./dist/domain/export.d.ts",
      "require": "./dist/domain/export.js",
      "default": "./dist/domain/export.js"
    }
  },
  "bin": {
    "sofagent-core": "dist/cli.js"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "postbuild": "node -e \"const fs=require('fs');for(const b of ['dist/cli.js']){try{fs.chmodSync(require('path').join(__dirname,b),0o755)}catch(e){}}\""
  },
  "keywords": [
    "sofagent",
    "core",
    "runtime",
    "doctor"
  ],
  "license": "MIT",
  "author": "KongFangXun",
  "repository": {
    "type": "git",
    "url": "https://github.com/KongFangXun/sofagent"
  },
  "bugs": {
    "url": "https://github.com/KongFangXun/sofagent/issues"
  },
  "homepage": "https://github.com/KongFangXun/sofagent#readme",
  "//": "v1.3.5 交付 4b：automerge 已切 @automerge/automerge ^3.4.1（与 orchestrator 同步切换，旧包名废弃）；federation.ts 迁移点 init/change/clone/merge，联邦合并测试验证收敛语义",
  "dependencies": {
    "@automerge/automerge": "^3.5.0",
    "fzstd": "^0.1.1",
    "js-yaml": "^5.4.2"
  },
  "files": [
    "dist/",
    "!dist/**/*.js.map",
    "!dist/**/*.d.ts.map",
    "!dist/**/*.test.*"
  ]
}
