{
  "name": "@sofagent/daemon",
  "version": "1.2.0",
  "description": "sofagent 守护进程 — 持续审计 / 文件监听 / 自动修复循环",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "sofagent-daemon": "dist/cli.js"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc && [ -f dist/cli.js ] && chmod +x dist/cli.js || true",
    "test": "vitest run",
    "check": "tsc --noEmit"
  },
  "keywords": [
    "sofagent",
    "daemon",
    "watcher",
    "continuous"
  ],
  "license": "MIT",
  "author": "KongFangXun",
  "dependencies": {
    "@sofagent/audit": "1.2.0",
    "@sofagent/core": "1.2.0",
    "@sofagent/ontology": "1.2.0",
    "@sofagent/orchestrator": "1.2.0",
    "automerge": "1.0.1-preview.7"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./federation": {
      "types": "./dist/federation/index.d.ts",
      "require": "./dist/federation/index.js",
      "default": "./dist/federation/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "usb/",
    "!dist/**/*.js.map",
    "!dist/**/*.d.ts.map",
    "!dist/**/*.test.*"
  ]
}
