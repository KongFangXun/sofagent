{
  "name": "@sofagent/daemon",
  "version": "1.3.2",
  "description": "sofagent 守护进程 — 持续审计 / 文件监听 / 自动修复循环",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "sofagent-daemon": "dist/cli.js"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "test": "vitest run",
    "check": "tsc --noEmit"
  },
  "keywords": [
    "sofagent",
    "daemon",
    "watcher",
    "continuous"
  ],
  "license": "MIT",
  "author": "KongFangXun",
  "dependencies": {
    "@sofagent/audit": "1.3.2",
    "@sofagent/core": "1.3.2",
    "@sofagent/ontology": "1.3.2",
    "@sofagent/orchestrator": "1.3.2",
    "@sofagent/skillopt": "1.3.2",
    "js-yaml": "^5.2.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./federation": {
      "types": "./dist/federation/index.d.ts",
      "require": "./dist/federation/index.js",
      "default": "./dist/federation/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "usb/",
    "!dist/**/*.js.map",
    "!dist/**/*.d.ts.map",
    "!dist/**/*.test.*"
  ]
}
