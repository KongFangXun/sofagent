{
  "name": "@sofagent/ab-test",
  "version": "1.2.0",
  "description": "sofagent A/B 测试框架 — 对比实验 / 指标显著性 / 实验报告",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "sofagent-ab-test": "dist/cli.js"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc",
    "test": "vitest run",
    "check": "tsc --noEmit"
  },
  "keywords": [
    "sofagent",
    "ab-test",
    "experiment",
    "evaluation"
  ],
  "license": "MIT",
  "author": "KongFangXun",
  "dependencies": {
    "@sofagent/orchestrator": "1.2.0",
    "@sofagent/harness": "1.2.0",
    "@sofagent/eval": "1.2.0",
    "@sofagent/core": "1.2.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "!dist/**/*.js.map",
    "!dist/**/*.d.ts.map",
    "!dist/**/*.test.*"
  ]
}
