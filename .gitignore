# sofagent runtime data
.sofagent/

# v1.2.1 数据目录迁移：运行时数据全在 ~/.sofagent/data/，仓库内不保留
/data/

# 编译产物
dist/

# v1.3.1 防御：tsc 若从根目录误跑（根 tsconfig 无 outDir），产物会输出到 src 旁
# 此规则防止误提交 src 下的 .js/.d.ts/.map（编译产物应在 dist/，不在 src/）
engine/*/src/**/*.js
engine/*/src/**/*.js.map
engine/*/src/**/*.d.ts.map
# 注意：engine/*/src/**/*.d.ts 不全 ignore——手写 ambient declaration（如 types/daemon.d.ts）需保留
# 只 ignore 有对应 .d.ts.map 的（编译产物特征）。由于 gitignore 无法表达"有 .map 才 ignore"，
# 此处只忽略 .d.ts.map（编译产物一定有 source map），.d.ts 本身靠 code review 把关
engine/*/src/**/*.d.ts
!engine/*/src/types/*.d.ts

# 依赖（P2-38: 显式声明——此前仅靠全局 gitignore 兜底，clone 到无全局规则的环境会误提交）
# ⚠️ P2-13 说明：仓库根 node_modules/ 是 npm workspace 依赖提升（hoisting）产生的物理目录，
#    由 npm install 生成、不入库；各 engine/* 子包内也可能有局部 node_modules（仅个别包的
#    本地依赖），同样不入库。
node_modules/

# hooks 包构建产物（由 src/handler.ts 生成，OpenClaw 声明式 hook 部署用）
engine/hooks/sofagent-load-chain/handler.ts

# ao compose 运行时产物（任务编排生成的工作流文件）
# 只忽略仓库根目录的 workflows/，不影响 .github/workflows/
/workflows/

# IDE / editor —— WorkBuddy 运行时产物，不进仓库
# ⚠️ .workbuddy/ 含开发日记/记忆/审查记录，绝不 track 或打包分发（P2-10）
.workbuddy/
.codebuddy/
.DS_Store
**/.DS_Store
*.swp
*.swo
*~

# OS
Thumbs.db

# agency-orchestrator local config
.env
/skills/
._DS_Store

# 临时调试文件
tmp/

# FORGE 运行产物（每个 loop 各自的 runs/，不进仓库）
FORGE/SKILL/*/runs/
# FORGE 父级 runs 目录防误收（v1.4.0 起；backend-ab-v1.3.9.md 是 v1.3.9 有意交付物，已跟踪保留）
FORGE/runs/

# 运行时数据 / 临时文件（不进版本库，v1.2.1 后 daemon 运行时产生）
engine/daemon/data/
# daemon 运行时发件箱（不进入版本控制）
engine/daemon/.sofagent/im-outbox/
*.tmp.sh
sofagent-audit-*.tgz

# pnpm 误生成防护（本项目用 npm）
pnpm-lock.yaml
pnpm-workspace.yaml
npm-p4-test/
p4npx/
stranger-audit-test/
t/
c.txt

# fresh-eyes worker 测试 fixture（run-07 教训：红队 worker 会创建这些文件测规则拦截）
config.js
config.local
f.txt

# 测试残留物防护（2026-08-16 根目录垃圾事件 + FORGE 教训）
sofagent-npm-test/
npm-p4-test/
p4npx/
t/
stranger-audit-test/
b.ts
c.txt

# TypeScript 增量编译缓存
tsconfig.tsbuildinfo
*.tsbuildinfo

# driver 主动实测产物（judgment-only 注入源，不入库）
acceptance-raw.log
