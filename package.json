    "node": ">=18"
  },
  "workspaces": [
    "engine/harness",
    "engine/ontology",
    "engine/eval",
    "engine/core",
    "engine/think",
    "engine/audit",
    "engine/orchestrator",
    "engine/daemon",
    "engine/ab-test",
    "engine/skillopt",
    "engine/mcp",
    "engine/rules",
    "engine/hooks/sofagent-load-chain",
