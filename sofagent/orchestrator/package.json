{
  "name": "@sofagent/orchestrator",
  "version": "1.1.4",
  "description": "sofagent 编排引擎 — 多 Agent 协作 / 工作流调度 / prompt 模板",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "sofagent-orchestrator": "dist/cli.js",
    "sofagent-orchestrator-compare": "dist/orchestrator-compare.js"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc",
    "test": "vitest run",
    "check": "tsc --noEmit"
  },
  "keywords": [
    "sofagent",
    "orchestrator",
    "workflow",
    "agent"
  ],
  "license": "MIT",
  "author": "KongFangXun",
  "dependencies": {
    "@langchain/langgraph": "^1.4.7",
    "@langchain/openai": "^1.5.5",
    "@sofagent/audit": "1.1.4",
    "@sofagent/core": "1.1.4",
    "@sofagent/harness": "1.1.4",
    "deepagents": "^1.10.7",
    "js-yaml": "^5.2.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "!dist/**/*.js.map",
    "!dist/**/*.d.ts.map",
    "!dist/**/*.test.*"
  ]
}
