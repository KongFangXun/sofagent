{
  "name": "@sofagent/orchestrator",
  "version": "1.1.2",
  "description": "sofagent 编排引擎 — 多 Agent 协作 / 工作流调度 / prompt 模板",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "sofagent-orchestrator": "dist/cli.js",
    "sofagent-orchestrator-compare": "dist/orchestrator-compare.js"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc",
    "test": "vitest run",
    "check": "tsc --noEmit"
  },
  "keywords": [
    "sofagent",
    "orchestrator",
    "workflow",
    "agent"
  ],
  "license": "MIT",
  "author": "KongFangXun",
  "dependencies": {
    "deepagents": "^1.10.7",
    "js-yaml": "^5.2.0",
    "@sofagent/harness": "1.1.2",
    "@sofagent/core": "1.1.2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  }
}
