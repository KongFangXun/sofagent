{
  "name": "@sofagent/audit",
  "version": "1.1.0",
  "description": "sofagent 提交时审计——扫描 git diff，检查 Agent 是否遵守工作纪律",
  "main": "dist/index.js",
  "types": "dist/public-api.d.ts",
  "exports": {
    ".": {
      "types": "./dist/public-api.d.ts",
      "default": "./dist/public-api.js"
    }
  },
  "bin": {
    "sofagent-audit": "dist/index.js",
    "@sofagent/audit": "dist/index.js",
    "sofagent-verify": "dist/verify.js",
    "sofagent-verify-evidence": "dist/verify-evidence.js",
    "verify-evidence": "dist/verify-evidence.js",
    "sofagent-env-check": "dist/env-check.js"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "rm -rf dist/ && npm run build && chmod +x dist/*.js && find dist -name '*.js.map' -delete && find dist -name '*.d.ts.map' -delete",
    "start": "node dist/index.js",
    "test": "vitest run",
    "check": "tsc --noEmit"
  },
  "keywords": [
    "sofagent",
    "audit",
    "git",
    "agent",
    "discipline",
    "mcp",
    "model-context-protocol"
  ],
  "license": "MIT",
  "author": "KongFangXun",
  "repository": {
    "type": "git",
    "url": "https://github.com/KongFangXun/sofagent"
  },
  "bugs": {
    "url": "https://github.com/KongFangXun/sofagent/issues"
  },
  "homepage": "https://github.com/KongFangXun/sofagent#readme",
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist/",
    "!dist/**/*.js.map",
    "!dist/**/*.d.ts.map",
    "!dist/**/*.test.*",
    "hooks/",
    "README.md"
  ],
  "dependencies": {
    "deepagents": "^1.10.7",
    "isomorphic-git": "^1.25.0",
    "js-yaml": "^5.2.0",
    "@sofagent/ontology": "1.1.0",
    "@sofagent/core": "1.1.0"
  }
}
