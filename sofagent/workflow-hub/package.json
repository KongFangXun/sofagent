{
  "name": "@sofagent/work模板市场",
  "version": "1.1.8",
  "description": "sofagent 工作流中心 — 工作流注册 / 模板管理 / 执行历史",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "sofagent-work模板市场": "dist/cli.js"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc",
    "test": "vitest run",
    "check": "tsc --noEmit"
  },
  "keywords": [
    "sofagent",
    "workflow",
    "hub",
    "template"
  ],
  "license": "MIT",
  "author": "KongFangXun",
  "dependencies": {
    "@sofagent/orchestrator": "1.1.8",
    "@sofagent/ontology": "1.1.8",
    "@sofagent/eval": "1.1.8"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "!dist/**/*.js.map",
    "!dist/**/*.d.ts.map",
    "!dist/**/*.test.*"
  ]
}
