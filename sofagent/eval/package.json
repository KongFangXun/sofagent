  "keywords": [
    "sofagent",
    "eval",
    "quality",
    "scoring"
  ],
  "license": "MIT",
  "author": "KongFangXun",
  "dependencies": {},
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "!dist/**/*.js.map",
    "!dist/**/*.d.ts.map",
    "!dist/**/*.test.*"
  ]
