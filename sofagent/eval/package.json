{
  "name": "@sofagent/eval",
  "version": "1.1.6",
  "description": "sofagent 质量评估引擎 — 量化指标 / 评分逻辑 / evals 接口",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc",
    "test": "vitest run",
    "check": "tsc --noEmit"
