{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@sofagent/harness": ["engine/harness/src"],
      "@sofagent/ontology": ["engine/ontology/src"],
      "@sofagent/eval": ["engine/eval/src"],
      "@sofagent/core": ["engine/core/src"],
      "@sofagent/audit": ["engine/audit/src"],
      "@sofagent/mcp": ["engine/mcp/src"],
      "@sofagent/orchestrator": ["engine/orchestrator/src"],
      "@sofagent/daemon": ["engine/daemon/src"],
      "@sofagent/ab-test": ["engine/ab-test/src"],
      "@sofagent/think": ["engine/think/src"],
      "@sofagent/skillopt": ["engine/skillopt/src"],
      "@sofagent/rules-engine": ["engine/rules-engine/src"]
    }
  },
  "include": ["engine/*/src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
