{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "noEmit": true,
    "sourceMap": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@sofagent/harness": [
        "engine/harness/src"
      ],
      "@sofagent/ontology": [
        "engine/ontology/src"
      ],
      "@sofagent/eval": [
        "engine/eval/src"
      ],
      "@sofagent/core": [
        "engine/core/src"
      ],
      "@sofagent/audit": [
        "engine/audit/src/public-api"
      ],
      "@sofagent/mcp": [
        "engine/mcp/src"
      ],
      "@sofagent/orchestrator": [
        "engine/orchestrator/src"
      ],
      "@sofagent/daemon": [
        "engine/daemon/src"
      ],
      "@sofagent/ab-test": [
        "engine/ab-test/src"
      ],
      "@sofagent/think": [
        "engine/think/src"
      ],
      "@sofagent/skillopt": [
        "engine/skillopt/src"
      ],
      "@sofagent/rules": [
        "engine/rules/src"
      ]
    },
    "types": [
      "node"
    ]
  },
  // v1.3.9 五十五：type-check 覆盖说明——本 tsconfig 只覆盖 engine/*/src 的 TS 产品代码。
  //   · FDE/ 为纯 Markdown 方法论文档（无 TS/JS 代码），无需 type-check；
  //   · FORGE/ 是内部自迭代工具链（.mjs ESM + 1 个 .ts 测试），不在 npm workspaces 内，
  //     走自身 vitest 入口（tools/forge/forge-smoke-test.sh），root tsconfig 有意不覆盖。
  "include": [
    "engine/*/src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "engine/*/src/**/*.test.ts",
    "engine/*/src/**/__tests__/**",
    "engine/*/src/cli.ts"
  ]
}