{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "noEmit": true,
    "sourceMap": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@sofagent/harness": [
        "engine/harness/src"
      ],
      "@sofagent/ontology": [
        "engine/ontology/src"
      ],
      "@sofagent/eval": [
        "engine/eval/src"
      ],
      "@sofagent/core": [
        "engine/core/src"
      ],
      "@sofagent/audit": [
        "engine/audit/src/public-api"
      ],
      "@sofagent/mcp": [
        "engine/mcp/src"
      ],
      "@sofagent/orchestrator": [
        "engine/orchestrator/src"
      ],
      "@sofagent/daemon": [
        "engine/daemon/src"
      ],
      "@sofagent/ab-test": [
        "engine/ab-test/src"
      ],
      "@sofagent/think": [
        "engine/think/src"
      ],
      "@sofagent/skillopt": [
        "engine/skillopt/src"
      ],
      "@sofagent/rules": [
        "engine/rules/src"
      ]
    },
    "types": [
      "node"
    ]
  },
  "include": [
    "engine/*/src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "engine/*/src/**/*.test.ts",
    "engine/*/src/**/__tests__/**",
    "engine/*/src/cli.ts"
  ]
}