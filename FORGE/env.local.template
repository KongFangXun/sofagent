# FORGE loop 模型环境变量模板（三厂商 key 全部列出，切模型只改 profile.mjs）
# 复制为 ~/.sofagent/env.local（仓库外）并填入真实 key 后 `source ~/.sofagent/env.local`
# 🔴 真实 key 文件已移出仓库目录（~/.sofagent/env.local），永不进 git；
#    FORGE/.gitignore 的 env.local 规则保留作兜底，防误落回仓内
#
# 设计：key 跟着模型走，不跟着角色走。
# 每个模型文件（FORGE/models/*.mjs）标注自己用哪个厂商的 key 变量，
# 切模型时 key 自动跟着模型切换，不需要手动改 env。
# 只需要把你买了的那几个厂商的 key 填上即可。

# ─── 阿里百炼 Qwen Token Plan ───
# 获取：https://bailian.console.aliyun.com/  → API-KEY 管理
# 用于：qwen3.8-max
export QWEN_API_KEY="sk-***REDACTED***"

# ─── 智谱 GLM Coding Plan ───
# 获取：https://open.bigmodel.cn/  → API Keys
# 用于：glm-5.3 / glm-5.3-flash（Coding Plan 专用端点）
export GLM_API_KEY="xxxxxxxxxxxxxxxx.xxxxxxxxxxxxxxxx"

# ─── DeepSeek ───
# 获取：https://platform.deepseek.com/  → API Keys
# 用于：deepseek-v4-pro / deepseek-flash（V4.1-Flash，两个模型共用同一个 key）
#       —— 当前六角色均走 GLM，本 key 无角色在用，仅在 profile.mjs 改选 DeepSeek 档时才需要
export DEEPSEEK_API_KEY="sk-***REDACTED***"

# ─── 角色占位变量（driver 启动检查要求非空，内容不影响模型选择——模型由 profile.mjs 决定）───
export SOFAGENT_LLM_A="active"
export SOFAGENT_LLM_B="active"
export SOFAGENT_LLM_C="active"   # 单盲四角色流水线：C（验收者）
export SOFAGENT_LLM_D="active"   # 单盲四角色流水线：D（复核者）
export SOFAGENT_LLM_V="active"
export SOFAGENT_LLM_F="active"   # v1.2.8 新增：release-gate-loop F（修复者）角色
